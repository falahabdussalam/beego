# ===================================================
# BeeGo Delivery - Environment Variables Configuration
# Hyperlocal Delivery Platform for Virajpete, Kodagu
# ===================================================

# Platform & Server URL
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME="BeeGo Delivery"
NEXT_PUBLIC_PLATFORM_TAGLINE="We deliver you."

# WhatsApp Business / Hyperlocal Ordering Number
# Format: International format without plus or spaces (e.g. 918277000000 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER="918277000000"
NEXT_PUBLIC_WHATSAPP_DISPLAY="+91 82770 00000"

# Location & Coverage Defaults (Virajpete Town Center)
NEXT_PUBLIC_DEFAULT_LAT=12.2039
NEXT_PUBLIC_DEFAULT_LNG=75.8037
NEXT_PUBLIC_DEFAULT_RADIUS_KM=5.0
NEXT_PUBLIC_LOCATION_NAME="Virajpete, Kodagu, Karnataka"

# Database Configuration (PostgreSQL / Supabase)
# Local PostgreSQL example: postgresql://postgres:password@localhost:5432/beego_db
# Supabase example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beego_db"

# Direct URL for migrations (if using Supabase connection pooler)
DIRECT_URL=""

# Authentication Secrets
# Generate with: openssl rand -base64 32
JWT_SECRET="beego_dev_secret_key_change_in_production_min_32_characters"
JWT_EXPIRES_IN="7d"

# Initial Admin Bootstrap Secret (used ONLY for initial seed or setup CLI script)
ADMIN_BOOTSTRAP_SECRET="beego_bootstrap_secure_key_2026"

# Google Maps API (JavaScript API, Places, Geocoding)
# Restrict this key to HTTP referrers in Google Cloud Console in production
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Payment Gateway (Razorpay Sandbox/Test Mode)
# Leave blank to use Cash on Delivery (COD) and built-in Sandbox Provider
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
ENABLE_COD=true

# Storage Provider (options: "local" | "supabase")
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="beego-assets"

# Notification Provider (options: "inapp" | "resend" | "twilio")
NOTIFICATION_PROVIDER="inapp"
RESEND_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Business Rules
MAX_CART_ITEMS_PER_ORDER=30
DEFAULT_DELIVERY_FEE=35.00
FREE_DELIVERY_THRESHOLD=499.00
BASE_TAX_PERCENTAGE=5.0
ORDER_CANCELLATION_MINUTES=5

